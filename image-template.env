# Parameters for the image build. The Justfile reads this file.

# ghcr.io/rowge/wasd
IMAGE_NAME=wasd

# GitHub account that owns the image. An organization can replace this later.
REPO_ORGANIZATION=rowge

IMAGE_DESC="WASD gaming desktop"
IMAGE_KEYWORDS="wasd,gaming,linux,nvidia"
IMAGE_LOGO_URL="https://github.com/rowge.png"
DEFAULT_TAG="latest"
BIB_IMAGE="quay.io/centos-bootc/bootc-image-builder:latest"
