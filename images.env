# Bazzite desktops WASD is built from. The workflow builds both.
# amd is the default WASD image (ghcr.io/rowge/wasd).
# nvidia is ghcr.io/rowge/wasd-nvidia.
# nvidia pin: ghcr.io/ublue-os/bazzite-nvidia-open:stable pinned 2026-11-03
# amd:    ghcr.io/ublue-os/bazzite:stable pinned 2026-11-03
# bazzite:stable is the AMD/Intel desktop. Deck and NVIDIA tags are different images.
nvidia_base=ghcr.io/ublue-os/bazzite-nvidia-open:stable@sha256:6490b14ac925831760c75d9cef7ea80c28a4c117a5926fe5b1dbdf7cc59dcec0
amd_base=ghcr.io/ublue-os/bazzite:stable@sha256:116f8bd50a4556becda96d03f6e71f716dfcd8eb9673891ec1acd8e58c51b549
