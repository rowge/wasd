# Bazzite desktops WASD is built from. The workflow builds both.
# amd is the default WASD image (ghcr.io/rowge/wasd).
# nvidia is ghcr.io/rowge/wasd-nvidia.
# nvidia pin: ghcr.io/ublue-os/bazzite-nvidia-open:stable pinned 2026-11-23
# amd:    ghcr.io/ublue-os/bazzite:stable pinned 2026-11-23
# bazzite:stable is the AMD/Intel desktop. Deck and NVIDIA tags are different images.
# Both are Bazzite 45.20261123.0. AMD was created 2026-11-23T04:55:40Z. NVIDIA was created 2026-11-23T04:56:03Z.
nvidia_base=ghcr.io/ublue-os/bazzite-nvidia-open:stable@sha256:ad740838824fabd6d91ba13304cdab229eab3d92ab45ee59189d8a92fd112283
amd_base=ghcr.io/ublue-os/bazzite:stable@sha256:80c2db31a56203a4d9d529b59dfc661999a8a654f60028bfa4cb8160eda9a878
