# Bazzite desktops WASD is built from. The workflow builds both.
# amd is the default WASD image (ghcr.io/rowge/wasd).
# nvidia is ghcr.io/rowge/wasd-nvidia.
# nvidia pin: ghcr.io/ublue-os/bazzite-nvidia-open:stable pinned 2026-11-15
# amd:    ghcr.io/ublue-os/bazzite:stable pinned 2026-11-15
# bazzite:stable is the AMD/Intel desktop. Deck and NVIDIA tags are different images.
# Both are Bazzite 45.20261115. AMD was created 2026-11-15T19:40:26Z. NVIDIA was created 2026-11-15T19:40:08Z.
nvidia_base=ghcr.io/ublue-os/bazzite-nvidia-open:stable@sha256:083ff2053c7dc4a8526e9699224f108c557e9b16f9bd275a2e4b8f2dd83744a4
amd_base=ghcr.io/ublue-os/bazzite:stable@sha256:c149116ad80db0ba73eaaff2210e9c6810f1e2d52987213d3a6fb83420e8f034
