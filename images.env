# Bazzite desktops WASD is built from. The workflow builds both.
# amd is the default WASD image (ghcr.io/rowge/wasd).
# nvidia is ghcr.io/rowge/wasd-nvidia.
# nvidia pin: ghcr.io/ublue-os/bazzite-nvidia-open:stable pinned 2026-11-25
# amd:    ghcr.io/ublue-os/bazzite:stable pinned 2026-11-25
# bazzite:stable is the AMD/Intel desktop. Deck and NVIDIA tags are different images.
# Both are Bazzite 45.20261125. AMD was created 2026-11-25T15:46:40Z. NVIDIA was created 2026-11-25T15:52:01Z.
nvidia_base=ghcr.io/ublue-os/bazzite-nvidia-open:stable@sha256:98a6a6a31670cbfa005866c6d6de2e768409dd7cb9db25f324b20cc55294fb89
amd_base=ghcr.io/ublue-os/bazzite:stable@sha256:b0c3d9928a0214c65283747ab9d92f8165ba71a80a8920a6398e9b0d77e6cf1d
