# Bazzite desktops WASD is built from. The workflow builds both.
# amd is the default WASD image (ghcr.io/rowge/wasd).
# nvidia is ghcr.io/rowge/wasd-nvidia.
# nvidia pin: ghcr.io/ublue-os/bazzite-nvidia-open:stable pinned 2026-11-11
# amd:    ghcr.io/ublue-os/bazzite:stable pinned 2026-11-11
# bazzite:stable is the AMD/Intel desktop. Deck and NVIDIA tags are different images.
# Both are Bazzite 45.20261111, revision b8881a9db67c6a6c341413a4c770db2814a34329.
nvidia_base=ghcr.io/ublue-os/bazzite-nvidia-open:stable@sha256:e55093691d95cd42f6e8115dc681ce95b07cbc935fb2393f58e4446cf1878585
amd_base=ghcr.io/ublue-os/bazzite:stable@sha256:2717668c53af1077c012f7ad3d6d4ef30bb7c6680af5d9592abdae4daa0e88ba
