# Bazzite desktops WASD is built from. The workflow builds both.
# amd is the default WASD image (ghcr.io/rowge/wasd).
# nvidia is ghcr.io/rowge/wasd-nvidia.
# nvidia pin: ghcr.io/ublue-os/bazzite-nvidia-open:stable pinned 2026-11-05
# amd:    ghcr.io/ublue-os/bazzite:stable pinned 2026-11-05
# bazzite:stable is the AMD/Intel desktop. Deck and NVIDIA tags are different images.
nvidia_base=ghcr.io/ublue-os/bazzite-nvidia-open:stable@sha256:9c3c4df94a7731238021549ed3fc951c3ae5e1fee37667d16754f37ae0f73134
amd_base=ghcr.io/ublue-os/bazzite:stable@sha256:3c67436e214fe34be11565cd3f0065789b1f107984ab247ca6cea4bcd2c94597
