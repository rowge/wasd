# Bazzite desktops WASD is built from. The workflow builds both.
# amd is the default WASD image (ghcr.io/rowge/wasd).
# nvidia is ghcr.io/rowge/wasd-nvidia.
# nvidia pin: ghcr.io/ublue-os/bazzite-nvidia-open:stable pinned 2026-11-13
# amd:    ghcr.io/ublue-os/bazzite:stable pinned 2026-11-13
# bazzite:stable is the AMD/Intel desktop. Deck and NVIDIA tags are different images.
# Both are Bazzite 45.20261111.0. AMD was created 2026-11-12T01:56:16Z. NVIDIA was created 2026-11-12T01:55:10Z.
nvidia_base=ghcr.io/ublue-os/bazzite-nvidia-open:stable@sha256:da914ab19940bf2959fba9bcba0c7359982dbb390e4759aa07b64cc58262e441
amd_base=ghcr.io/ublue-os/bazzite:stable@sha256:1ca1d7b5b93b9b00d07c602b6e0ace73933216a9c6eacc233e2bcb254aab2d25
