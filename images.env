# Bazzite desktops WASD is built from. The workflow builds both.
# amd is the default WASD image (ghcr.io/rowge/wasd).
# nvidia is ghcr.io/rowge/wasd-nvidia.
# nvidia pin: ghcr.io/ublue-os/bazzite-nvidia-open:stable pinned 2026-11-17
# amd:    ghcr.io/ublue-os/bazzite:stable pinned 2026-11-17
# bazzite:stable is the AMD/Intel desktop. Deck and NVIDIA tags are different images.
# Both are Bazzite 45.20261117.1. AMD was created 2026-11-17T15:42:26Z. NVIDIA was created 2026-11-17T15:45:38Z.
nvidia_base=ghcr.io/ublue-os/bazzite-nvidia-open:stable@sha256:49ded650b432c2943bb940cedc91950ad150b7c73a7f2bb12e08a34590446e82
amd_base=ghcr.io/ublue-os/bazzite:stable@sha256:492f83c738838861464685aed341783c2ea2266c82a9f19f0c867fd301783fd4
