# Bazzite desktops WASD is built from. The workflow builds both.
# amd is the default WASD image (ghcr.io/rowge/wasd).
# nvidia is ghcr.io/rowge/wasd-nvidia.
# nvidia pin: ghcr.io/ublue-os/bazzite-nvidia-open:stable pinned 2026-10-27
# amd:    ghcr.io/ublue-os/bazzite:stable pinned 2026-10-27
# bazzite:stable is the AMD/Intel desktop. Deck and NVIDIA tags are different images.
nvidia_base=ghcr.io/ublue-os/bazzite-nvidia-open:stable@sha256:fecc39b4b278dabd27092d0b0cad01a6ab4ce7eb07b669561150fa77dea684c7
amd_base=ghcr.io/ublue-os/bazzite:stable@sha256:ee82a885dbb77cd4604a5ffa8278a0eef0bc84d16850045c7b9d847729da9949
