# Bazzite desktops WASD is built from. The workflow builds both.
# amd is the default WASD image (ghcr.io/rowge/wasd).
# nvidia is ghcr.io/rowge/wasd-nvidia.
# nvidia pin: ghcr.io/ublue-os/bazzite-nvidia-open:stable pinned 2026-11-04
# amd:    ghcr.io/ublue-os/bazzite:stable pinned 2026-11-04
# bazzite:stable is the AMD/Intel desktop. Deck and NVIDIA tags are different images.
nvidia_base=ghcr.io/ublue-os/bazzite-nvidia-open:stable@sha256:1afdfa96a8011ae269e8a79dc550e1024fb953f19b3a0483c6522ad4d5d1f3d1
amd_base=ghcr.io/ublue-os/bazzite:stable@sha256:9ef3035588c6760e96c5064a1920db35c012c6c8e7d20ac6c1c31a04ed682e0b
