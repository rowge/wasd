<!DOCTYPE Menu PUBLIC "-//freedesktop//DTD Menu 1.0//EN"
 "http://www.freedesktop.org/standards/menu-spec/menu-1.0.dtd">
<Menu>
  <Name>Applications</Name>
  <Menu>
    <Name>Games</Name>
    <Layout>
      <Filename>wasd-starship.desktop</Filename>
      <Merge type="menus"/>
      <Merge type="files"/>
    </Layout>
    <Menu>
      <Name>FreeOnline</Name>
      <Directory>wasd-free-online.directory</Directory>
      <Include>
        <And>
          <Category>Game</Category>
          <Category>X-WASD-FreeOnline</Category>
        </And>
      </Include>
    </Menu>
    <Exclude>
      <Category>X-WASD-FreeOnline</Category>
    </Exclude>
  </Menu>
</Menu>
