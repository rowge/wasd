<!DOCTYPE Menu PUBLIC "-//freedesktop//DTD Menu 1.0//EN"
 "http://www.freedesktop.org/standards/menu-spec/menu-1.0.dtd">
<Menu>
  <Name>Applications</Name>
  <Menu>
    <Name>Games</Name>
    <Layout>
      <Menuname>BrowserGames</Menuname>
      <Menuname>RealGames</Menuname>
      <Menuname>Emulators</Menuname>
      <Merge type="menus"/>
      <Merge type="files"/>
    </Layout>
    <Menu>
      <Name>BrowserGames</Name>
      <Directory>wasd-browser-games.directory</Directory>
      <Include>
        <And>
          <Category>Game</Category>
          <Category>X-WASD-BrowserGames</Category>
        </And>
      </Include>
    </Menu>
    <Menu>
      <Name>RealGames</Name>
      <Directory>wasd-real-games.directory</Directory>
      <Include>
        <Category>X-WASD-RealGames</Category>
        <Filename>io.itch.itch.desktop</Filename>
        <Filename>com.play0ad.zeroad.desktop</Filename>
        <Filename>org.openttd.OpenTTD.desktop</Filename>
        <Filename>net.supertuxkart.SuperTuxKart.desktop</Filename>
        <Filename>org.luanti.luanti.desktop</Filename>
        <Filename>org.wesnoth.Wesnoth.desktop</Filename>
        <Filename>org.freeciv.sdl2.desktop</Filename>
      </Include>
    </Menu>
    <Menu>
      <Name>Emulators</Name>
      <Directory>wasd-emulators.directory</Directory>
      <Include>
        <Filename>org.libretro.RetroArch.desktop</Filename>
        <Filename>org.DolphinEmu.dolphin-emu.desktop</Filename>
        <Filename>net.pcsx2.PCSX2.desktop</Filename>
        <Filename>net.rpcs3.RPCS3.desktop</Filename>
      </Include>
    </Menu>
    <Menu>
      <Name>Arcade</Name>
      <Exclude>
        <Filename>net.supertuxkart.SuperTuxKart.desktop</Filename>
      </Exclude>
    </Menu>
    <Menu>
      <Name>TacticStrategy</Name>
      <Exclude>
        <Filename>com.play0ad.zeroad.desktop</Filename>
        <Filename>org.wesnoth.Wesnoth.desktop</Filename>
        <Filename>org.freeciv.sdl2.desktop</Filename>
      </Exclude>
    </Menu>
    <Exclude>
      <Category>X-WASD-BrowserGames</Category>
      <Category>X-WASD-RealGames</Category>
      <Filename>io.itch.itch.desktop</Filename>
      <Filename>com.play0ad.zeroad.desktop</Filename>
      <Filename>org.openttd.OpenTTD.desktop</Filename>
      <Filename>net.supertuxkart.SuperTuxKart.desktop</Filename>
      <Filename>org.luanti.luanti.desktop</Filename>
      <Filename>org.wesnoth.Wesnoth.desktop</Filename>
      <Filename>org.freeciv.sdl2.desktop</Filename>
      <Filename>org.libretro.RetroArch.desktop</Filename>
      <Filename>org.DolphinEmu.dolphin-emu.desktop</Filename>
      <Filename>net.pcsx2.PCSX2.desktop</Filename>
      <Filename>net.rpcs3.RPCS3.desktop</Filename>
    </Exclude>
  </Menu>
</Menu>
