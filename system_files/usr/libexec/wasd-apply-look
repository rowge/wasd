#!/bin/bash
# Write the chosen login picture and prepare the loading picture.
# WASD Look sets the wallpaper itself before it runs this.
# This does not reboot.

set -euo pipefail

names_only=0
current=0
sync_lock=0
clear_avatar=0
avatar_set=0
login=""
loading=""
avatar=""

current_avatar() {
    python3 - << 'PY'
import hashlib
import os
from pathlib import Path

def digest(path):
    return hashlib.sha256(path.read_bytes()).hexdigest()

icons = Path("/usr/share/wasd/icons")
user = os.environ.get("USER") or ""
home = Path(os.environ.get("HOME") or "")
found = None
for candidate in (Path("/var/lib/AccountsService/icons") / user, home / ".face"):
    if user and candidate.is_file():
        found = candidate
        break
if found is None or not icons.is_dir():
    print("")
    raise SystemExit
target = digest(found)
match = ""
for icon in sorted(icons.iterdir()):
    if not icon.is_file() or icon.name == "wasd-logo.png":
        continue
    if icon.suffix.lower() not in {".jpg", ".jpeg", ".png", ".webp"}:
        continue
    if digest(icon) == target:
        match = icon.name
        break
print(match)
PY
}

apply_avatar() {
    local uid user home src dest face users
    uid=${PKEXEC_UID:-}
    if [[ -z $uid || $uid == 0 ]]; then
        echo "The user picture was not changed." >&2
        return 1
    fi
    user=$(id -nu "$uid")
    if [[ ! $user =~ ^[a-z][a-z0-9-]{0,31}$ || $user == root ]]; then
        echo "The user picture was not changed." >&2
        return 1
    fi
    home=$(getent passwd "$user" | cut -d: -f6)
    if [[ -z $home || $home != /* || ! -d $home ]]; then
        echo "The user picture was not changed." >&2
        return 1
    fi
    install -d -m 0755 /var/lib/AccountsService/icons /var/lib/AccountsService/users
    dest=/var/lib/AccountsService/icons/$user
    face=$home/.face
    users=/var/lib/AccountsService/users/$user
    if [[ -n $avatar ]]; then
        src=${root}/icons/${avatar}
        if [[ ! -f $src ]]; then
            echo "That picture is not installed." >&2
            return 1
        fi
        install -m 0644 "$src" "$dest"
        install -m 0644 "$src" "$face"
        chown "$user:$user" "$face"
        rm -f "$home/.face.icon"
    else
        rm -f "$dest" "$face" "$home/.face.icon"
    fi
    python3 - "$users" "$user" "$avatar" << 'PY'
import sys
from pathlib import Path
path, user, avatar = sys.argv[1:]
icon = f"/var/lib/AccountsService/icons/{user}" if avatar else ""
file = Path(path)
text = file.read_text() if file.is_file() else ""
out = []
saw_user = False
in_user = False
inserted = False
for line in text.splitlines():
    stripped = line.strip()
    if stripped == "[User]":
        saw_user = True
        in_user = True
        out.append(line)
        continue
    if stripped.startswith("[") and stripped.endswith("]"):
        if in_user and icon and not inserted:
            out.append(f"Icon={icon}")
            inserted = True
        in_user = False
    if in_user and line.startswith("Icon="):
        continue
    if in_user and line.startswith("SystemAccount="):
        out.append("SystemAccount=false")
        continue
    out.append(line)
if not saw_user:
    if out and out[-1] != "":
        out.append("")
    out.append("[User]")
    out.append("SystemAccount=false")
if icon and not inserted:
    out.append(f"Icon={icon}")
file.write_text("\n".join(out).rstrip() + "\n")
PY
    chmod 0644 "$users"
    if [[ -f /etc/wasd/choices.json ]]; then
        python3 - "$avatar" << 'PY'
import json
import sys
from pathlib import Path
path = Path("/etc/wasd/choices.json")
try:
    data = json.loads(path.read_text())
except (OSError, json.JSONDecodeError):
    raise SystemExit(0)
if isinstance(data, dict):
    data["avatar"] = sys.argv[1]
    path.write_text(json.dumps(data, indent=2) + "\n")
PY
    fi
}

write_lock_image() {
    local dest=$1 url=$2 owner=${3-}
    local dir
    dir=$(dirname "$dest")
    if [[ -n $owner ]]; then
        if [[ ! -d $dir ]]; then
            install -d -m 0755 -o "$owner" -g "$owner" "$dir"
        fi
    else
        install -d -m 0755 "$dir"
    fi
    python3 - "$dest" "$url" << 'PY'
import sys
from pathlib import Path

dest, url = sys.argv[1], sys.argv[2]

def set_group(text, header, updates):
    lines = text.splitlines()
    start = None
    for index, line in enumerate(lines):
        if line.strip() == header:
            start = index
            break
    if start is None:
        if lines and lines[-1] != "":
            lines.append("")
        lines.append(header)
        for key, value in updates.items():
            lines.append(f"{key}={value}")
        return "\n".join(lines).rstrip() + "\n"
    end = len(lines)
    for index in range(start + 1, len(lines)):
        stripped = lines[index].strip()
        if stripped.startswith("[") and stripped.endswith("]"):
            end = index
            break
    body = lines[start + 1:end]
    for key, value in updates.items():
        prefix = key + "="
        found = False
        for index, line in enumerate(body):
            if line.startswith(prefix):
                body[index] = prefix + value
                found = True
                break
        if not found:
            body.append(prefix + value)
    return "\n".join(lines[: start + 1] + body + lines[end:]).rstrip() + "\n"

path = Path(dest)
text = path.read_text() if path.is_file() else ""
text = set_group(text, "[Greeter]", {"WallpaperPlugin": "org.kde.image"})
text = set_group(
    text,
    "[Greeter][Wallpaper][org.kde.image][General]",
    {"Image": url, "PreviewImage": url},
)
path.write_text(text)
PY
    chmod 0644 "$dest"
    if [[ -n $owner ]]; then
        chown "$owner:$owner" "$dest"
    fi
}

while [[ $# -gt 0 ]]; do
    case $1 in
        --names-only)
            names_only=1
            shift
            ;;
        --current)
            current=1
            shift
            ;;
        --sync-lock)
            login=${2-}
            sync_lock=1
            shift 2
            ;;
        --clear-avatar)
            clear_avatar=1
            avatar_set=1
            shift
            ;;
        --login)
            login=${2-}
            shift 2
            ;;
        --loading)
            loading=${2-}
            shift 2
            ;;
        --avatar)
            avatar=${2-}
            avatar_set=1
            shift 2
            ;;
        *)
            echo "Unknown argument." >&2
            exit 2
            ;;
    esac
done

if [[ $current -eq 1 ]]; then
    current_avatar
    exit 0
fi

name_ok='^[A-Za-z0-9._-]+$'
if [[ $sync_lock -eq 1 ]]; then
    if [[ -n ${WASD_LOOK_ROOT:-} ]]; then
        echo "WASD_LOOK_ROOT is only for a name check." >&2
        exit 2
    fi
    if [[ ! $login =~ $name_ok ]]; then
        echo "Use a picture from the list." >&2
        exit 2
    fi
    login_src=/usr/share/wasd/login/${login}
    if [[ ! -f $login_src ]]; then
        echo "That picture is not installed." >&2
        exit 1
    fi
    url="file://${login_src}"
    write_lock_image /etc/xdg/kscreenlockerrc "$url"
    write_lock_image /etc/skel/.config/kscreenlockerrc "$url"
    exit 0
fi
if [[ ! $login =~ $name_ok || ! $loading =~ $name_ok ]]; then
    echo "Use a picture from the list." >&2
    exit 2
fi
if [[ $clear_avatar -eq 1 && -n $avatar ]]; then
    echo "Use one picture." >&2
    exit 2
fi
if [[ $avatar_set -eq 1 && $clear_avatar -eq 0 && ( ! $avatar =~ $name_ok || $avatar == wasd-logo.png ) ]]; then
    echo "Use a picture from the list." >&2
    exit 2
fi

if [[ -n ${WASD_LOOK_ROOT:-} && $names_only -eq 0 ]]; then
    echo "WASD_LOOK_ROOT is only for a name check." >&2
    exit 2
fi

root=${WASD_LOOK_ROOT:-/usr/share/wasd}
login_src=${root}/login/${login}
loading_src=${root}/loading/${loading}
if [[ ! -f $login_src || ! -f $loading_src ]]; then
    echo "That picture is not installed." >&2
    exit 1
fi
if [[ -n $avatar && ! -f ${root}/icons/${avatar} ]]; then
    echo "That picture is not installed." >&2
    exit 1
fi

if [[ $names_only -eq 1 ]]; then
    printf '%s\n%s\n' "$login_src" "$loading_src"
    exit 0
fi

if [[ $avatar_set -eq 1 ]] && ! apply_avatar; then
    exit 1
fi

install -d -m 0755 /etc/wasd
dest=/etc/wasd/loading-background.png
case ${loading_src##*.} in
    png | PNG)
        install -m 0644 "$loading_src" "$dest"
        ;;
    *)
        converted=0
        if command -v ffmpeg >/dev/null 2>&1; then
            if ffmpeg -y -loglevel error -i "$loading_src" "$dest"; then
                converted=1
            fi
        fi
        if [[ $converted -eq 0 ]] && command -v magick >/dev/null 2>&1; then
            if magick "$loading_src" "$dest"; then
                converted=1
            fi
        fi
        if [[ $converted -eq 0 ]] && command -v convert >/dev/null 2>&1; then
            if convert "$loading_src" "$dest"; then
                converted=1
            fi
        fi
        if [[ $converted -ne 1 || ! -s $dest ]]; then
            echo "Could not prepare the loading picture." >&2
            exit 1
        fi
        chmod 0644 "$dest"
        ;;
esac

tmp=$(mktemp)
trap 'rm -f "$tmp"' EXIT
defaults=/usr/lib/plasmalogin/defaults.conf
if [[ -f $defaults ]]; then
    cp "$defaults" "$tmp"
else
    printf '%s\n' '[Greeter]' 'WallpaperPlugin=org.kde.image' '' '[Greeter][Wallpaper][org.kde.image][General]' >"$tmp"
fi
url="file://${login_src}"
if grep -q '^Image=' "$tmp"; then
    sed -i "s|^Image=.*|Image=${url}|" "$tmp"
else
    printf 'Image=%s\n' "$url" >>"$tmp"
fi
if grep -q '^PreviewImage=' "$tmp"; then
    sed -i "s|^PreviewImage=.*|PreviewImage=${url}|" "$tmp"
else
    printf 'PreviewImage=%s\n' "$url" >>"$tmp"
fi
install -m 0644 "$tmp" /etc/plasmalogin.conf
write_lock_image /etc/xdg/kscreenlockerrc "$url"
write_lock_image /etc/skel/.config/kscreenlockerrc "$url"
lock_uid=${PKEXEC_UID:-}
if [[ $lock_uid =~ ^[0-9]+$ && $lock_uid != 0 ]]; then
    lock_user=$(id -nu "$lock_uid" 2>/dev/null || true)
    if [[ $lock_user =~ ^[a-z][a-z0-9-]{0,31}$ ]]; then
        lock_home=$(getent passwd "$lock_user" | cut -d: -f6 || true)
        if [[ -n $lock_home && $lock_home == /* && -d $lock_home ]]; then
            write_lock_image "$lock_home/.config/kscreenlockerrc" "$url" "$lock_user"
        fi
    fi
fi

rebuild_loading() {
    local log output status
    log=$(mktemp)
    if command -v rpm-ostree >/dev/null 2>&1; then
        set +e
        output=$(rpm-ostree initramfs --enable --arg=-I --arg=/etc/wasd/loading-background.png 2>&1)
        status=$?
        set -e
        if [[ $status -eq 0 ]]; then
            rm -f "$log"
            return 0
        fi
        if grep -qi 'already enabled' <<<"$output"; then
            # The same request does not rebuild. Turn it off and back on
            # so this picture is included. Neither command reboots.
            if ! rpm-ostree initramfs --disable >"$log" 2>&1; then
                cat "$log" >&2
                rm -f "$log"
                return 1
            fi
            if ! rpm-ostree initramfs --enable --arg=-I --arg=/etc/wasd/loading-background.png >"$log" 2>&1; then
                cat "$log" >&2
                rm -f "$log"
                return 1
            fi
            rm -f "$log"
            return 0
        fi
        printf '%s\n' "$output" >&2
        rm -f "$log"
        return "$status"
    fi
    if command -v dracut >/dev/null 2>&1; then
        if ! dracut -f >"$log" 2>&1; then
            cat "$log" >&2
            rm -f "$log"
            return 1
        fi
        rm -f "$log"
        return 0
    fi
    rm -f "$log"
    echo "This system cannot rebuild the loading screen." >&2
    return 1
}

if ! rebuild_loading; then
    if [[ $avatar_set -eq 1 ]]; then
        echo "The user picture and the login screen are saved. The lock screen uses that same picture. The loading screen waits for the next system update, then a restart."
    else
        echo "The login screen is saved. The lock screen uses that same picture. The loading screen waits for the next system update, then a restart."
    fi
    exit 0
fi

if [[ $avatar_set -eq 1 ]]; then
    echo "The user picture and the login screen change at the next login. The lock screen uses that same picture the next time the screen locks. The loading screen changes on the next boot."
else
    echo "The login screen changes at the next login. The lock screen uses that same picture the next time the screen locks. The loading screen changes on the next boot."
fi
